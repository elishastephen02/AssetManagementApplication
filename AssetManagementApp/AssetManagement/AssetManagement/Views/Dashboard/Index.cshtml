@model DashboardViewModel;

@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-wide">
    <div class="page-header">
        <h1>Dashboard</h1>
    </div>
    <div class="dashboard-container">
        <div class="map-panel">
            <div id="map"></div>
        </div>
        <div class="side-panel">
            <h2>Blocks</h2>
            <div class="block-grid-wrapper">
                <div class="asset-row">
                    <div class="summary-block">
                        <span class="block-title">Total Pipe Length (m)</span>
                        <span class="block-value">@Model.TotalLength m</span>
                    </div>
                    <div class="summary-block">
                        <span class="block-title">Average Condition Rating</span>
                        <div id="avgConditionGauge"></div>
                    </div>
                    <div class="summary-block">
                        <span class="block-title">Total Current Replacement Cost</span>
                        <span class="block-value">R @Model.TotalCRC.ToString("0.00")</span>
                    </div>
                </div>
                <div class="asset-row inactive">
                    <div class="summary-block">
                        <span class="block-title">Manholes</span>
                        <span class="block-value">--</span>
                    </div>
                    <div class="summary-block">
                        <span class="block-title">Avg Condition Rating</span>
                        <span class="block-value">--</span>
                    </div>
                    <div class="summary-block">
                        <span class="block-title">Current Replacement Cost</span>
                        <span class="block-value">--</span>
                    </div>
                </div>
                <div class="asset-row inactive">
                    <div class="summary-block">
                        <span class="block-title">Canals</span>
                        <span class="block-value">--</span>
                    </div>
                    <div class="summary-block">
                        <span class="block-title">Avg Condition Rating</span>
                        <span class="block-value">--</span>
                    </div>
                    <div class="summary-block">
                        <span class="block-title">Current Replacement Cost</span>
                        <span class="block-value">--</span>
                    </div>
                </div>
                <div class="asset-row inactive">
                    <div class="summary-block">
                        <span class="block-title">Culverts</span>
                        <span class="block-value">--</span>
                    </div>
                    <div class="summary-block">
                        <span class="block-title">Avg Condition Rating</span>
                        <span class="block-value">--</span>
                    </div>
                    <div class="summary-block">
                        <span class="block-title">Current Replacement Cost</span>
                        <span class="block-value">--</span>
                    </div>
                </div>
                <div class="asset-row inactive">
                    <div class="summary-block">
                        <span class="block-title">Outfall</span>
                        <span class="block-value">--</span>
                    </div>
                    <div class="summary-block">
                        <span class="block-title">Avg Condition Rating</span>
                        <span class="block-value">--</span>
                    </div>
                    <div class="summary-block">
                        <span class="block-title">Current Replacement Cost</span>
                        <span class="block-value">--</span>
                    </div>
                </div>
                <div class="asset-row inactive">
                    <div class="summary-block">
                        <span class="block-title">Pump stations</span>
                        <span class="block-value">--</span>
                    </div>
                    <div class="summary-block">
                        <span class="block-title">Avg Condition Rating</span>
                        <span class="block-value">--</span>
                    </div>
                    <div class="summary-block">
                        <span class="block-title">Current Replacement Cost</span>
                        <span class="block-value">--</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<style>
    .page-wide {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: 0 20px;
    box-sizing: border-box;
    }

    .page-header {
    padding: 15px 20px;
    background: #ffffff;
    border-bottom: 1px solid #ddd;
    margin-bottom: 10px;
    }

    .page-header h1 {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    }

    .dashboard-container {
    display: flex;
    gap: 15px;
    margin-bottom: 20px;
    width: 100%;
    }

    .map-panel {
    flex: 3;
    min-width: 0;
    }

    #map {
    width: 100%;
    height: 550px;
    border-radius: 8px;
    border: 1px solid #ddd;
    }

    .side-panel {
    flex: 1;
    background: #f4f4f4;
    padding: 15px;
    border-radius: 8px;
    height: 550px;
    min-width: 420px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-sizing: border-box;
    }

    .side-panel h2 {
    margin-top: 0;
    margin-bottom: 10px;
    flex-shrink: 0;
    text-align: center;
    }

    .block-grid-wrapper {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    min-height: 0;
    padding-right: 5px;
    }

    .asset-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 12px;
    align-items: stretch;
    }

    .summary-block {
    background: white;
    border-radius: 10px;
    padding: 14px 10px;
    height: 115px;
    box-sizing: border-box;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    border: 1px solid #ddd;
    box-shadow: 0 2px 6px rgba(0,0,0,0.06);
    }

    .asset-row.inactive .summary-block {
    background: #f0f0f0;
    color: #aaa;
    box-shadow: none;
    }

    .block-title {
    font-size: 12px;
    font-weight: 600;
    color: #666;
    margin-bottom: 8px;
    line-height: 1.4;
    }

    .asset-row.inactive .block-title {
    color: #bbb;
    }

    .block-value {
    font-size: 12px;
    font-weight: 500;
    color: #222;
    word-break: break-word;
    }

    .asset-row.inactive .block-value {
    color: #bbb;
    }

    .side-panel hr {
    margin: 12px 0;
    border: none;
    border-top: 1px solid #ddd;
    flex-shrink: 0;
    }

    .side-panel h3 {
    margin: 0 0 8px;
    font-size: 14px;
    text-align: center;
    }

    .block-item {
    padding: 10px;
    margin-bottom: 8px;
    background: white;
    cursor: pointer;
    border-left: 4px solid #ccc;
    border-radius: 0 4px 4px 0;
    transition: background 0.2s;
    }

    .block-item:hover {
    background: #eaeaea;
    }

    .block-grid-wrapper::-webkit-scrollbar {
    width: 6px;
    }

    .block-grid-wrapper::-webkit-scrollbar-track {
    background: #f1f1f1;
    }

    .block-grid-wrapper::-webkit-scrollbar-thumb {
    background: #bdbdbd;
    border-radius: 4px;
    }

    .block-grid-wrapper::-webkit-scrollbar-thumb:hover {
    background: #999;
    }
</style>

<script>
    var kznBounds = L.latLngBounds(
    [-31.90, 28.80],   // South-West (Port Edward area)
    [-26.40, 33.20]    // North-East (Mozambique border)
    );

    var map = L.map('map', {
    minZoom: 7,
    maxZoom: 18,
    maxBounds: kznBounds,
    maxBoundsViscosity: 0.8
    }).setView([-29.8587, 31.0218], 11);

    var streetLayer = L.tileLayer(
    'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
    { maxZoom: 19, attribution: '© OpenStreetMap contributors' }
    );

    var satelliteLayer = L.tileLayer(
    'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
    { maxZoom: 19, attribution: 'Tiles © Esri' }
    );

    streetLayer.addTo(map);

    L.control.layers(
    { "Street Map": streetLayer, "Satellite": satelliteLayer },
    null,
    { position: 'topright', collapsed: false }
    ).addTo(map);

    function getColor(value) {
    if (value == null || isNaN(value)) return "#9E9E9E";

    if (value < 40) return "#E53935";      // Red
    if (value < 60) return "#FB8C00";      // Orange
    if (value < 75) return "#FDD835";      // Yellow

    return "#81C784";                      // Light Green
    }

    // AVERAGE CONDITION RATING GAUGE
    function renderAvgConditionGauge(condition) {
    if (condition === undefined || condition === null || isNaN(condition)) condition = 0;
    condition = Number(condition);
    condition = Math.max(0, Math.min(100, condition));

    const radius = 34;
    const circumference = Math.PI * radius;
    const progress = circumference * (condition / 100);
    const offset = circumference - progress;

    let color;
    if (condition > 70)      color = "#4CAF50";
    else if (condition > 50) color = "#FFC107";
    else                     color = "#F44336";

    const gaugeEl = document.getElementById("avgConditionGauge");
    if (!gaugeEl) return;

    gaugeEl.innerHTML = `
    <svg width="90" height="55" viewBox="0 0 90 55">
    <path d="M11 45 A34 34 0 0 1 79 45"
    fill="none" stroke="#e5e7eb" stroke-width="7" stroke-linecap="round"/>
    <path d="M11 45 A34 34 0 0 1 79 45"
    fill="none" stroke="${color}" stroke-width="7" stroke-linecap="round"
    stroke-dasharray="${circumference}" stroke-dashoffset="${offset}"/>
    <text x="45" y="38" text-anchor="middle"
    font-size="14" font-weight="700" fill="${color}">
    ${condition.toFixed(1)}%
    </text>
    </svg>`;
    }

    // Render on load using the server-side average condition rating
    renderAvgConditionGauge(@Model.TotalCR);

    fetch('/Dashboard/GetDashboardMap')
    .then(res => {
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    return res.json();
    })
    .then(data => {
    console.log(`Loaded ${data.features?.length ?? 0} features`);

    if (!data.features || data.features.length === 0) {
    console.warn("No features returned from API");
    return;
    }

    console.log(data);
    console.log(data.features.length);

    var geojsonLayer = L.geoJSON(data, {

    // Don't display areas with a condition rating of 0
    filter: function (feature) {
    const condition = Number(feature.properties.condition);
    return !isNaN(condition) && condition > 0;
    },

    style: function (feature) {

    const condition = Number(feature.properties.condition);

    let fillColor = "#9E9E9E";
    let fillOpacity = 0.45;

    if (condition < 40) {
    fillColor = "#E53935";      // Red
    fillOpacity = 0.55;
    }
    else if (condition < 60) {
    fillColor = "#FB8C00";      // Orange
    fillOpacity = 0.50;
    }
    else if (condition < 75) {
    fillColor = "#FDD835";      // Yellow
    fillOpacity = 0.45;
    }
    else {
    fillColor = "#81C784";      // Light Green
    fillOpacity = 0.30;         // Nice transparent green
    }

    return {
    fillColor: fillColor,
    color: "#666",
    weight: 0.8,
    fillOpacity: fillOpacity
    };
    },

    onEachFeature: function (feature, layer) {
    const name = feature.properties.blockName ?? "Unknown";
    const condition = Number(feature.properties.condition);

    layer.bindPopup(`
    <b>${name}</b><br>
    Avg Condition: ${condition.toFixed(1)}%
    `);

    // Only build sidebar list if blockList exists
    const blockListEl = document.getElementById("blockList");

    if (blockListEl) {
    const div = document.createElement("div");
    div.className = "block-item";
    div.style.borderLeftColor = getColor(condition);
    div.innerHTML = `
    <b>${name}</b><br>
    <small>${condition.toFixed(1)}%</small>
    `;

    div.onclick = function () {
    map.fitBounds(layer.getBounds(), { padding: [20, 20] });
    layer.openPopup();
    };

    blockListEl.appendChild(div);
    }
    }
    }).addTo(map);

    // Only zoom if at least one block exists
    if (geojsonLayer.getLayers().length > 0) {
    map.fitBounds(geojsonLayer.getBounds(), {
    padding: [80, 80],
    maxZoom: 13
    });
    }
    })
    .catch(err => {
    console.error("Failed to load map data:", err);
    });
</script>