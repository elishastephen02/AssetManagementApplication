    // CCTV DIAGRAM
    function renderCCTVDiagram(item, insp) {
        const obs = (insp?.Observations || []);
        const totalLength = parseFloat(insp?.InspectedLength || item?.InspectedLength || 0);

        const upNode = item?.UpstreamNode || "MH-UP";
        const downNode = item?.DownstreamNode || "MH-DN";

        const material = item?.Material || "—";
        const diameter = item?.PipeDiameter ? item.PipeDiameter + " mm" : "—";
        const address = item?.Address || "—";

        const SVG_W = 1400;
        let SVG_H = 900;
        SVG_H += obs.length * 90;

        const MH_R = 28;

        // Pipe positions
        const START_X = 100;
        const END_X = 1180;

        // slight downward angle
        const START_Y = 170;
        const END_Y = 240;

        const PIPE_WALL = 14;
        const PIPE_GAP = 28;

        const PIPE_TOP_START = START_Y - PIPE_GAP / 2;
        const PIPE_BOTTOM_START = START_Y + PIPE_GAP / 2;

        const PIPE_TOP_END = END_Y - PIPE_GAP / 2;
        const PIPE_BOTTOM_END = END_Y + PIPE_GAP / 2;

        const OBS_START_Y = 320;

        function posToX(metres) {
            if (!totalLength) return START_X;

            return START_X + ((parseFloat(metres) || 0) / totalLength) * (END_X - START_X);
        }

        function posToY(metres) {
            if (!totalLength) return START_Y;

            return START_Y + ((parseFloat(metres) || 0) / totalLength) * (END_Y - START_Y);
        }

        function obsColor(code) {
            code = (code || "").toUpperCase();

            if (["MH", "MHF"].includes(code)) return "#555";
            if (code === "WL") return "#1a56db";
            if (code === "GP") return "#888";
            if (["OBP", "OBS", "OB"].includes(code)) return "#E8593C";
            if (code.startsWith("D")) return "#A32D2D";
            if (code.startsWith("S")) return "#EF9F27";

            return "#555";
        }

        function gradeColor(g) {
            const n = parseFloat(g);

            if (isNaN(n)) return "#555";

            return n >= 4
                ? "#A32D2D"
                : n >= 3
                    ? "#854F0B"
                    : "#3B6D11";
        }

        function gradeBg(g) {
            const n = parseFloat(g);

            if (isNaN(n)) return "#f0f0f0";

            return n >= 4
                ? "#FCEBEB"
                : n >= 3
                    ? "#FAEEDA"
                    : "#EAF3DE";
        }

        const getRank = (code) => {
            code = (code || "").toUpperCase();

            if (code === "START" || code === "MH") return 0;
            if (code === "WL") return 1;
            return 2;
        };

        const sortedObs = [...obs].sort((a, b) => {
            const codeA = (a.Code || "").toUpperCase();
            const codeB = (b.Code || "").toUpperCase();

            const rankA = getRank(codeA);
            const rankB = getRank(codeB);

            const distA = parseFloat(a.Distance) || 0;
            const distB = parseFloat(b.Distance) || 0;

            // 1. STRICT priority first (this fixes your flip issue)
            if (rankA !== rankB) return rankA - rankB;

            // 2. THEN distance
            if (distA !== distB) return distA - distB;

            return 0;
        });

        let obsSvg = "";

        sortedObs.forEach((o, idx) => {

            const x = posToX(o.Distance);
            const y = posToY(o.Distance);

            const color = obsColor(o.Code);

            const desc = (o.Observation || "No description")
                .replace(/</g, "&lt;");

            const image = (o.Media || [])
                .find(m => /\.(jpg|jpeg|png)$/i.test(m.FileName || ""));

            const imageHref = image
                ? `/Map/GetImage?fileName=${encodeURIComponent(image.FileName)}`
                : null;

            const ROW_HEIGHT = 170;
            const labelY = OBS_START_Y + (idx * ROW_HEIGHT);

            // leader line
            obsSvg += `
                <line
                    x1="${x}"
                    y1="${y + 12}"
                    x2="${x}"
                    y2="${labelY - 18}"
                    stroke="#bbb"
                    stroke-width="1"
                    stroke-dasharray="4 4"
                />
            `;

            // pipe defect marker
            obsSvg += `
                <circle
                    cx="${x}"
                    cy="${y}"
                    r="6"
                    fill="${color}"
                    stroke="white"
                    stroke-width="2"
                />
            `;

            // code pill
            obsSvg += `
                <rect
                    x="${x - 18}"
                    y="${labelY - 14}"
                    width="36"
                    height="18"
                    rx="6"
                    fill="${color}"
                    opacity="0.15"
                />

                <text
                    x="${x}"
                    y="${labelY - 1}"
                    text-anchor="middle"
                    font-size="10"
                    font-weight="700"
                    fill="${color}">
                    ${(o.Code || "").substring(0, 5)}
                </text>
            `;

            // distance
            obsSvg += `
                <text
                    x="${x}"
                    y="${labelY + 18}"
                    text-anchor="middle"
                    font-size="10"
                    fill="#777">
                    ${(parseFloat(o.Distance || 0)).toFixed(2)}m
                </text>
            `;

            // description
            obsSvg += `
                <foreignObject
                    x="${x - 70}"
                    y="${labelY + 24}"
                    width="140"
                    height="50">

                    <div xmlns="http://www.w3.org/1999/xhtml"
                         style="
                            font-size:11px;
                            text-align:center;
                            color:#333;
                            line-height:1.3;
                            font-family:sans-serif;
                         ">
                        ${desc.length > 60 ? desc.substring(0, 60) + "…" : desc}
                    </div>

                </foreignObject>
            `;

            // grade badge
            if (o.Grade != null) {

                obsSvg += `
                    <rect
                        x="${x - 14}"
                        y="${labelY + 78}"
                        width="28"
                        height="18"
                        rx="8"
                        fill="${gradeBg(o.Grade)}"
                    />

                    <text
                        x="${x}"
                        y="${labelY + 91}"
                        text-anchor="middle"
                        font-size="10"
                        font-weight="700"
                        fill="${gradeColor(o.Grade)}">
                        ${o.Grade}
                    </text>
                `;
            }

            // image directly underneath
            if (imageHref) {

                obsSvg += `
                    <a href="javascript:void(0)"
                       onclick="openImageModal('${imageHref}')">

                        <image
                            href="${imageHref}"
                            x="${x - 55}"
                            y="${labelY + 150}"
                            height="60"
                            width="110"
                            preserveAspectRatio="xMidYMid slice"
                            style="cursor:pointer;"
                        />

                        <rect
                            x="${x - 55}"
                            y="${labelY + 150}"
                            height="60"
                            width="110"
                            rx="6"
                            fill="transparent"
                            stroke="#ccc"
                            stroke-width="1"
                        />
                    </a>
                `;
            }
        });

        return `
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="100%"
            viewBox="0 0 ${SVG_W} ${SVG_H}"
            style="font-family:sans-serif;display:block;overflow:visible;">

            <!-- Header -->
            <rect x="0" y="0" width="${SVG_W}" height="48" fill="#1a56db" rx="8"/>

            <text
                x="18"
                y="18"
                font-size="10"
                font-weight="700"
                fill="#dbeafe">
                CCTV INSPECTION
            </text>

            <text
                x="18"
                y="35"
                font-size="11"
                fill="#bfdbfe">
                ${address} · ${material} · Ø ${diameter}
            </text>

            <text
                x="${SVG_W - 18}"
                y="28"
                text-anchor="end"
                font-size="11"
                fill="#bfdbfe">
                ${totalLength} m
            </text>

            <!-- Pipe walls -->
            <line
                x1="${START_X}"
                y1="${PIPE_TOP_START}"
                x2="${END_X}"
                y2="${PIPE_TOP_END}"
                stroke="#cfcfcf"
                stroke-width="${PIPE_WALL}"
                stroke-linecap="round"
            />

            <line
                x1="${START_X}"
                y1="${PIPE_BOTTOM_START}"
                x2="${END_X}"
                y2="${PIPE_BOTTOM_END}"
                stroke="#cfcfcf"
                stroke-width="${PIPE_WALL}"
                stroke-linecap="round"
            />

            <!-- Flow direction -->
            <defs>
                <marker id="flowArrow"
                        viewBox="0 0 10 10"
                        refX="8"
                        refY="5"
                        markerWidth="6"
                        markerHeight="6"
                        orient="auto">

                    <path
                        d="M 0 0 L 10 5 L 0 10 z"
                        fill="#1a56db"/>
                </marker>
            </defs>

            <line
                x1="${START_X + 40}"
                y1="${START_Y}"
                x2="${END_X - 40}"
                y2="${END_Y}"
                stroke="#1a56db"
                stroke-width="2"
                opacity="0.35"
                marker-end="url(#flowArrow)"
            />

            <!-- Observations -->
            ${obsSvg}

            <!-- Upstream MH -->
            <circle
                cx="${START_X}"
                cy="${START_Y}"
                r="${MH_R}"
                fill="#f3f4f6"
                stroke="#555"
                stroke-width="2"
            />

            <text
                x="${START_X}"
                y="${START_Y - 5}"
                text-anchor="middle"
                font-size="10"
                font-weight="700"
                fill="#333">
                MH
            </text>

            <text
                x="${START_X}"
                y="${START_Y + 10}"
                text-anchor="middle"
                font-size="9"
                fill="#555">
                ${upNode}
            </text>

            <!-- Downstream MH -->
            <circle
                cx="${END_X}"
                cy="${END_Y}"
                r="${MH_R}"
                fill="#f3f4f6"
                stroke="#555"
                stroke-width="2"
            />

            <text
                x="${END_X}"
                y="${END_Y - 5}"
                text-anchor="middle"
                font-size="10"
                font-weight="700"
                fill="#333">
                MH
            </text>

            <text
                x="${END_X}"
                y="${END_Y + 10}"
                text-anchor="middle"
                font-size="9"
                fill="#555">
                ${downNode}
            </text>

        </svg>`;
    }

    // IMAGE MODAL
    function openImageModal(src) {
        const modal    = document.getElementById("imageModal");
        const modalImg = document.getElementById("modalImage");
        modalImg.src   = src;
        modal.style.display = "flex";
    }

    function closeImageModal() {
        document.getElementById("imageModal").style.display = "none";
    }

    document.addEventListener("DOMContentLoaded", () => {
        document.getElementById("modalImage").addEventListener("click", e => e.stopPropagation());
    });

    // ACCORDION
    function toggleAccordion(header, id) {
        let content = header.nextElementSibling;
        let icon    = header.querySelector(".accordion-icon");
        let isOpen  = content.style.display === "block";
        document.querySelectorAll(".infra-accordion-content").forEach(c => c.style.display = "none");
        document.querySelectorAll(".accordion-icon").forEach(i => i.textContent = "+");
        if (!isOpen) {
            content.style.display = "block";
            icon.textContent = "−";
            highlightPipe(id);
        }
    }
</script>
