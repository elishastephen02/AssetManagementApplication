@model List<string>

<div class="container mt-4">
    <div class="card shadow p-4">
        <h2 class="text-success mb-3">Select Tables</h2>

        <form asp-action="Columns" method="post">
            <input type="hidden" name="filePath" value="@ViewBag.FilePath" />

            @foreach (var table in Model)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                           name="selectedTables" value="@table" id="tbl_@table" />
                    <label class="form-check-label" for="tbl_@table">@table</label>
                </div>
            }

            <button type="submit" class="btn btn-primary mt-3">Next: Choose Columns</button>
        </form>
    </div>
</div>