@model MultiSelectionViewModel

<div class="container mt-4 mb-5">
    <h2>Select Columns to Import</h2>

    <form asp-action="Import" method="post">
        <input type="hidden" asp-for="FilePath" />

        @for (int i = 0; i < Model.Tables.Count; i++)
        {
            <div class="card mb-3 p-3">
                <h4>@Model.Tables[i].TableName</h4>
                <input type="hidden" name="Tables[@i].TableName" value="@Model.Tables[i].TableName" />

                @foreach (var col in Model.Tables[i].Columns)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               name="Tables[@i].SelectedColumns"
                               value="@col.ColumnName" />
                        <label class="form-check-label">
                            @col.ColumnName (@col.DataType)
                        </label>
                    </div>
                }
            </div>
        }

        <button type="submit" class="btn btn-success">Import Selected Data</button>
    </form>
</div>